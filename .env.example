# Live Show Radar: environment variables. Copy to .env.local for local runs (never commit real values).
# In production, set these in Vercel (Project → Settings → Environment Variables) or with `npx vercel env add NAME`.

# ── AI (Gemini Flash only) ──────────────────────────────────────────────
# Preferred gateway: OpenRouter, Google models only, served by Google infrastructure (provider.only=google-vertex/google-ai-studio).
OPENROUTER_API_KEY=
# Optional alternative: direct Gemini API key (used only if OPENROUTER_API_KEY is empty).
GEMINI_API_KEY=
# google/gemini-3.7-flash is auto-routed to 3.8 by Google (deprecations page), so 3.8 is the default. Never a Flash-Lite model.
GEMINI_MODEL=google/gemini-3.8-flash
# Daily caps (IST day). Grounded = calls with Google Search (OpenRouter web plugin, engine=native).
GEMINI_DAILY_CALL_BUDGET=400
GEMINI_DAILY_GROUNDED_BUDGET=160
GEMINI_GROUNDING_ENABLED=true
SCOUT_CALLS_PER_RUN=3

# ── Database (Neon Postgres; the Vercel Neon integration sets DATABASE_URL) ──
DATABASE_URL=

# ── Spotify (Authorization Code + PKCE; Development Mode, owner login only) ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://YOUR-APP.vercel.app/api/spotify/callback

# ── Email alerts via Resend (the alert channel) ─────────────────────────
RESEND_API_KEY=
FROM_EMAIL=
ALERT_EMAIL=

# ── App security ────────────────────────────────────────────────────────
CRON_SECRET=
ADMIN_PASSWORD=
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=https://YOUR-APP.vercel.app
HOME_CITY=Bengaluru

# ── Optional adapters ───────────────────────────────────────────────────
BANDSINTOWN_APP_ID=
TICKETMASTER_API_KEY=
# Google News RSS is off by default because news.google.com/robots.txt disallows /rss.
GOOGLE_NEWS_RSS_ENABLED=false
# MOCK_MODE=1 forces in-memory DB, no AI calls and mock notifications.
MOCK_MODE=
